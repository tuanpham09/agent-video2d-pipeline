{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "video2d/manifest.schema.json",
  "title": "audio/manifest.json",
  "x-schema-version": 1,
  "type": "object",
  "required": [
    "version",
    "engine",
    "sample_rate",
    "speed",
    "duration",
    "full_audio",
    "scenes"
  ],
  "properties": {
    "version": {
      "type": "integer"
    },
    "engine": {
      "const": "vieneu-v3-turbo"
    },
    "sample_rate": {
      "type": "integer",
      "minimum": 8000
    },
    "speed": {
      "type": "number",
      "minimum": 1.2,
      "maximum": 1.3
    },
    "duration": {
      "type": "number",
      "minimum": 0
    },
    "full_audio": {
      "type": "string"
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "start",
          "duration",
          "lines"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^S\\d{2}$"
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "duration": {
            "type": "number",
            "minimum": 0
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "speaker",
                "text",
                "start",
                "duration",
                "audio"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "speaker": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "text": {
                  "type": "string"
                },
                "start": {
                  "type": "number",
                  "minimum": 0
                },
                "duration": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "audio": {
                  "type": "string"
                },
                "gap_after": {
                  "type": "number",
                  "minimum": 0
                },
                "words": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "start",
                      "end"
                    ],
                    "properties": {
                      "start": {
                        "type": "number"
                      },
                      "end": {
                        "type": "number"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
