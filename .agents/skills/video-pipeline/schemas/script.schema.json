{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "video2d/script.schema.json",
  "title": "script/script.json",
  "x-schema-version": 1,
  "type": "object",
  "required": [
    "meta",
    "characters",
    "scenes"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "project",
        "title",
        "format",
        "width",
        "height",
        "fps",
        "language"
      ],
      "properties": {
        "format": {
          "enum": [
            "9:16",
            "16:9"
          ]
        },
        "fps": {
          "type": "integer",
          "minimum": 1
        },
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        },
        "language": {
          "const": "vi"
        }
      }
    },
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "role",
          "voice"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "role": {
            "enum": [
              "narrator",
              "character"
            ]
          },
          "voice": {
            "type": "string",
            "minLength": 1
          },
          "temperature": {
            "type": "number",
            "minimum": 0,
            "maximum": 2
          }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "lines"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^S\\d{2}$"
          },
          "title": {
            "type": "string"
          },
          "goal": {
            "type": "string"
          },
          "visual": {
            "type": "string"
          },
          "pause_after": {
            "type": "number",
            "minimum": 0
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "speaker",
                "text"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^S\\d{2}_L\\d{2}[a-z]?$"
                },
                "speaker": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "pause_after": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    }
  }
}
